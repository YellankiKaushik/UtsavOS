{
  "name": "utsavos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/ai",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "api:generate": "node scripts/generate-openapi.mjs",
    "db:types": "node scripts/generate-database-types.mjs",
    "test:live": "node scripts/preflight-live.mjs providers && vitest run --config vitest.live.config.ts",
    "security:client": "node scripts/scan-client-secrets.mjs",
    "test:e2e:live": "node scripts/preflight-live.mjs browser && playwright test --config playwright.live.config.ts",
    "test:ai:live": "node scripts/preflight-live.mjs corpus && vitest run --config vitest.ai-live.config.ts",
    "test:concurrency": "vitest run --config vitest.concurrency.config.ts",
    "test:providers:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:live:public": "playwright test --config playwright.public-live.config.ts"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "date-fns-tz": "3.2.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "openai": "7.44.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.12",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
